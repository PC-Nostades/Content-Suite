# =============================================================================
# Content Suite — Frontend
# ⚠️ Vite solo expone variables con prefijo VITE_, y TODO lo que expone es
#    PÚBLICO (queda en el bundle). Nunca poner aquí la GEMINI_API_KEY ni
#    claves de Supabase.
# =============================================================================

# Ruta RELATIVA en producción: el static site de Render proxea /api/* hacia la
# API, así que frontend y backend comparten origen y CORS no entra en juego.
# En local, el proxy de vite.config.ts reproduce esa misma condición.
# Para volver a cross-origin, poner la URL absoluta de la API.
VITE_API_BASE_URL=/api/v1

# Muestra la tarjeta con las 3 cuentas de demo en /login (útil para el evaluador)
VITE_SHOW_DEMO_CREDENTIALS=true

# Feature flags: los módulos II y III se encienden sin tocar código
VITE_ENABLE_MODULE_CONTENT=false
VITE_ENABLE_MODULE_GOVERNANCE=false

# --- Secretos: NUNCA commitear ---
# El patrón .env.* necesita las negaciones de abajo; sin ellas `git add` ignora
# silenciosamente los .env.example y el evaluador clona un repo que no puede correr.
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key

# --- Python / backend ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

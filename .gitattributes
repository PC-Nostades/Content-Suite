# Normaliza finales de línea: LF en el repo, nativo en el working copy.
# Evita que un checkout en Windows genere diffs falsos y que Render (Linux)
# reciba scripts con CRLF.
* text=auto eol=lf

# Binarios: nunca tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfiles: se generan, no se revisan a mano
package-lock.json -diff linguist-generated

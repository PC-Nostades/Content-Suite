# =============================================================================
# Content Suite — Backend
# Copia este archivo a `.env` y rellena los valores. `.env` NUNCA se commitea.
# En Render estas variables van en el dashboard (las marcadas `sync: false`).
# =============================================================================

# --- App ---
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SQL_ECHO=false

# --- Auth (JWT propio) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720          # 12 h: cubre toda la sesión de evaluación sin refresh token

# --- Supabase / Postgres ---
# ⚠️ USAR EL SESSION POOLER, NO LA CONEXIÓN DIRECTA.
#    La conexión directa de Supabase es IPv6-only y Render no tiene IPv6 saliente.
#    Dashboard Supabase → Connect → Session pooler (puerto 5432).
#    - El usuario lleva punto: postgres.<PROJECT_REF>
#    - El host termina en .pooler.supabase.com  (si dice db.<ref>.supabase.co es la directa: MAL)
#    - El driver debe ser postgresql+asyncpg://  (no postgresql://)
#    - Si la contraseña tiene @ : / ? # [ ] % hay que URL-encodearla
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Proveedor de LLM ---
# 'openai' o 'gemini'. Se cambia sin tocar código: app/ai/llm.py despacha al
# módulo correspondiente y ambos exponen la misma interfaz.
#
# ⚠️ Por qué OpenAI y no Gemini: el free tier de Gemini limita a 20 peticiones
#    AL DÍA por modelo (GenerateRequestsPerDayPerProjectPerModel). El agente
#    consume 4 llamadas por manual → 5 manuales diarios, incluidos los que
#    genere el evaluador. La demo moriría con un 429.
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# none: estas tareas son generación estructurada guiada por prompts, no resolución
# de problemas. "minimal" NO está soportado por gpt-5.6-luna.
OPENAI_REASONING_EFFORT=none

# --- Gemini (fallback documentado) ---
# ⚠️ Los model ids van SIN el prefijo "models/" en el SDK google-genai.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Común ---
# 1536: dimensión NATIVA de text-embedding-3-small y por debajo del límite de
# 2000 que pgvector puede indexar con el tipo `vector`. Con 3072 el índice HNSW
# no se crea y el fallo solo aparecería al usar el RAG.
EMBEDDING_DIM=1536
LLM_TIMEOUT_SECONDS=180

# --- Langfuse (observabilidad) ---
# ⚠️ La variable es LANGFUSE_BASE_URL. LANGFUSE_HOST era la del SDK v2.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local

# --- CORS ---
# Red de seguridad: en producción el SPA proxea /api/* desde su propio origen y
# no debería dispararse ni un preflight. Esto permite volver a cross-origin
# cambiando solo VITE_API_BASE_URL, sin tocar código.
# Lista separada por comas, SIN barra final.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo ---
SEED_ON_STARTUP=true
DEMO_PASSWORD=Alicorp2026!
